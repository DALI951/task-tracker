rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isManager(uid) {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.role == 'manager';
    }

    // The Task Tracker Admin panel account: full read across tenants and the
    // write rights the admin panel needs (account creation, task/problem
    // final flips). Only users whose OWN users/{uid} doc carries
    // role == 'admin' qualify.
    function isAdmin() {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isEmployeeOf(managerEmail) {
      return isAuth() &&
        exists(/databases/$(database)/documents/employees/$(userEmail())) &&
        get(/databases/$(database)/documents/employees/$(userEmail())).data.createdBy == managerEmail;
    }

    // ─── Users ────────────────────────────────────────────────

    match /users/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow read: if isAuth() && isManager(request.auth.uid);
      allow read: if isAuth() && resource.data.role == 'manager';
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ─── Tasks ────────────────────────────────────────────────

    match /tasks/{taskId} {
      // Managers: create tasks they own
      allow create: if isAuth() && isManager(request.auth.uid)
        && request.resource.data.createdBy == userEmail();

      // Managers: read their own tasks. Reads never reference
      // request.resource (only defined on writes), so a read can't be denied
      // by a stale write-guard clause.
      allow read: if isAuth() && isManager(request.auth.uid)
        && resource.data.createdBy == userEmail();

      // Managers: update/delete their own tasks. A review may only be
      // approved after the employee's complete upload has been recorded.
      // Legacy tasks without the flag stay protected.
      allow update, delete: if isAuth() && isManager(request.auth.uid)
        && resource.data.createdBy == userEmail()
        && (!(
          resource.data.status == 'pending_review' &&
          request.resource.data.status == 'completed'
        ) || request.resource.data.uploadsComplete == true);

      // Admin panel: full visibility + final flips (approve, stop upload).
      allow read: if isAdmin();
      allow update: if isAdmin();

      // Employees: read tasks assigned to their email
      allow read: if isAuth() &&
        resource.data.assignedToEmail == userEmail();

      // Employees: claim / complete / reset their own tasks
      allow update: if isAuth() &&
        resource.data.assignedToEmail == userEmail() &&
        resource.data.status != 'completed' &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'claimedBy', 'claimedByName', 'photoUrl', 'history',
                    'photoUrls', 'completionDescription', 'uploadsComplete',
                    'uploadCompleted', 'uploadTotal',
                    'rejectionReason', 'completedAt', 'startedAt'])
        // Employees cannot submit a review state while uploads are partial.
        && (request.resource.data.status != 'pending_review' ||
            request.resource.data.uploadsComplete == true);
    }

    // ─── Employees (manager directory) ────────────────────────

    match /employees/{email} {
      // Managers: create employees
      allow create: if isAuth() && isManager(request.auth.uid);

      // Managers: read/update/delete their own employees
      allow read, update, delete: if isAuth() && isManager(request.auth.uid)
        && resource.data.createdBy == userEmail();

      // Employees: read their own directory entry (interim delete check)
      allow read: if isAuth() && email == userEmail();

      // Admin panel: read/write the whole directory (account management).
      allow read, write: if isAdmin();
    }

    // ─── Preset Tasks ─────────────────────────────────────────

    match /preset_tasks/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && isManager(request.auth.uid);
      allow update, delete: if isAuth() && isManager(request.auth.uid)
        && resource.data.createdBy == userEmail();
    }

    // ─── Preset Items ─────────────────────────────────────────

    match /preset_items/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && isManager(request.auth.uid);
      allow update, delete: if isAuth() && isManager(request.auth.uid)
        && resource.data.createdBy == userEmail();
    }

    // ─── Problems ─────────────────────────────────────────────

    match /problems/{id} {
      // Problems are tenant-scoped by managerEmail. An employee creates a
      // problem stamped with the email of the manager who created their
      // directory entry (verified here, so it can't be spoofed to another
      // tenant); a manager can report problems to their own email.
      allow create: if isAuth()
        && request.resource.data.managerEmail is string
        && request.resource.data.managerEmail != ''
        && (
          (isManager(request.auth.uid)
            && request.resource.data.managerEmail == userEmail())
          || isEmployeeOf(request.resource.data.managerEmail)
        );

      // Managers only see problems tagged to their own email.
      allow read: if isAuth() && isManager(request.auth.uid)
        && resource.data.managerEmail == userEmail();

      // Employees can read the problems they reported (e.g. the "My Reports"
      // list with upload status).
      allow read: if isAuth() && resource.data.reportedBy == userEmail();

      // The reporter may update their own problem while it is being uploaded
      // (progress fields, partial photoUrls). It may only flip to 'open' once
      // the upload is complete — mirrors the task employee-update rule so a
      // half-uploaded report can never be presented as delivered.
      allow update: if isAuth() && resource.data.reportedBy == userEmail()
        && resource.data.status == 'uploading'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['photoUrl', 'photoUrls', 'uploadsComplete',
                    'uploadCompleted', 'uploadTotal', 'status'])
        && (request.resource.data.status != 'open'
            || request.resource.data.uploadsComplete == true);

      allow update, delete: if isAuth() && isManager(request.auth.uid)
        && resource.data.managerEmail == userEmail();

      // Admin panel: full visibility + final flips on any problem.
      allow read: if isAdmin();
      allow update: if isAdmin();
    }

    // ─── Notifications ────────────────────────────────────────

    match /notifications/{notifId} {
      allow create: if isAuth();
      allow read: if isAuth() &&
        resource.data.recipientEmail == userEmail();
      allow update: if isAuth() &&
        resource.data.recipientEmail == userEmail();
      allow delete: if isAuth() &&
        resource.data.recipientEmail == userEmail();
    }

    // Temporary v0.4.10 push diagnostics. The app writes these records;
    // investigation reads them with the Firebase service account.
    match /push_diagnostics/{diagnosticId} {
      allow create: if isAuth();
    }

    // ─── Invites (manager signup links) ───────────────────────
    // Written/read only by Cloud Functions (Admin SDK) and managers;
    // the invite code itself is the credential for redemption.

    match /invites/{code} {
      allow read, write: if isAuth() && isManager(request.auth.uid);
    }
  }
}
