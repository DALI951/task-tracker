rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isManager(uid) {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.role == 'manager';
    }

    function userEmail() {
      return request.auth.token.email;
    }

    // ─── Users ────────────────────────────────────────────────

    match /users/{uid} {
      allow read, write: if isAuth() && request.auth.uid == uid;
      allow read: if isAuth() && isManager(request.auth.uid);
      allow read: if isAuth() && resource.data.role == 'manager';
    }

    // ─── Tasks ────────────────────────────────────────────────

    match /tasks/{taskId} {
      // Managers: create tasks they own
      allow create: if isAuth() && isManager(request.auth.uid)
        && request.resource.data.createdBy == userEmail();

      // Managers: read/update/delete their own tasks
      allow read, update, delete: if isAuth() && isManager(request.auth.uid)
        && resource.data.createdBy == userEmail();

      // Employees: read tasks assigned to their email
      allow read: if isAuth() &&
        resource.data.assignedToEmail == userEmail();

      // Employees: claim / complete / reset their own tasks
      allow update: if isAuth() &&
        resource.data.assignedToEmail == userEmail() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'claimedBy', 'claimedByName', 'photoUrl', 'history',
                    'rejectionReason', 'completedAt', 'startedAt']);
    }

    // ─── Employees (manager directory) ────────────────────────

    match /employees/{email} {
      // Managers: create employees
      allow create: if isAuth() && isManager(request.auth.uid);

      // Managers: read/update/delete their own employees
      allow read, update, delete: if isAuth() && isManager(request.auth.uid)
        && resource.data.createdBy == userEmail();
    }

    // ─── Preset Tasks ─────────────────────────────────────────

    match /preset_tasks/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && isManager(request.auth.uid);
      allow update, delete: if isAuth() && isManager(request.auth.uid)
        && resource.data.createdBy == userEmail();
    }

    // ─── Preset Items ─────────────────────────────────────────

    match /preset_items/{id} {
      allow read: if isAuth();
      allow create: if isAuth() && isManager(request.auth.uid);
      allow update, delete: if isAuth() && isManager(request.auth.uid)
        && resource.data.createdBy == userEmail();
    }

    // ─── Problems ─────────────────────────────────────────────

    match /problems/{id} {
      // Clients create problems; managerEmail is stamped by a Cloud
      // Function trigger so it can't be spoofed from the client.
      allow create: if isAuth() && !('managerEmail' in request.resource.data);

      // Managers see problems reported by their own employees. Legacy
      // documents without a managerEmail stay visible to all managers
      // until a one-time backfill tags them.
      allow read: if isAuth() && (resource.data.reportedBy == userEmail()
          || (isManager(request.auth.uid)
              && (resource.data.managerEmail == userEmail()
                  || resource.data.managerEmail == null)));

      allow update, delete: if isAuth() && isManager(request.auth.uid)
          && (resource.data.managerEmail == userEmail()
              || resource.data.managerEmail == null);
    }

    // ─── Notifications ────────────────────────────────────────

    match /notifications/{notifId} {
      allow create: if isAuth();
      allow read: if isAuth() &&
        resource.data.recipientEmail == userEmail();
      allow update: if isAuth() &&
        resource.data.recipientEmail == userEmail();
      allow delete: if isAuth() &&
        resource.data.recipientEmail == userEmail();
    }

    // ─── Invites (manager signup links) ───────────────────────
    // Written/read only by Cloud Functions (Admin SDK) and managers;
    // the invite code itself is the credential for redemption.

    match /invites/{code} {
      allow read, write: if isAuth() && isManager(request.auth.uid);
    }
  }
}
