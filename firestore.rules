rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ───────────────────────────────────────────────

    function isAuth() {
      return request.auth != null;
    }

    function isManager(uid) {
      return isAuth() &&
        exists(/databases/$(database)/documents/users/$(uid)) &&
        get(/databases/$(database)/documents/users/$(uid)).data.role == 'manager';
    }

    function userEmail() {
      return request.auth.token.email;
    }

    // ─── Users ────────────────────────────────────────────────

    match /users/{uid} {
      // Owner can read/write their own doc
      allow read, write: if isAuth() && request.auth.uid == uid;
      // Managers can read all user docs (for admin dashboard)
      allow read: if isAuth() && isManager(request.auth.uid);
      // All auth'd users can read other user docs (needed for FCM token lookup)
      allow read: if isAuth();
    }

    // ─── Tasks ────────────────────────────────────────────────

    match /tasks/{taskId} {
      // Managers: full access
      allow read, write: if isAuth() && isManager(request.auth.uid);

      // Employees: read tasks assigned to their email
      allow read: if isAuth() &&
        resource.data.assignedToEmail == userEmail();

      // Employees: claim / complete / reset their own tasks
      allow update: if isAuth() &&
        resource.data.assignedToEmail == userEmail() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'claimedBy', 'claimedByName', 'photoUrl', 'history',
                    'rejectionReason', 'completedAt', 'startedAt']);
    }

    // ─── Employees (manager directory) ────────────────────────

    match /employees/{email} {
      allow read, write: if isAuth() && isManager(request.auth.uid);
    }

    // ─── Preset Tasks ─────────────────────────────────────────

    match /preset_tasks/{id} {
      allow read: if isAuth();
      allow write: if isAuth() && isManager(request.auth.uid);
    }

    // ─── Preset Items ─────────────────────────────────────────

    match /preset_items/{id} {
      allow read: if isAuth();
      allow write: if isAuth() && isManager(request.auth.uid);
    }

    // ─── Problems ─────────────────────────────────────────────

    match /problems/{id} {
      allow create: if isAuth();
      allow read: if isAuth();
      allow update: if isAuth() && isManager(request.auth.uid);
      allow delete: if isAuth() && isManager(request.auth.uid);
    }

    // ─── Notifications ────────────────────────────────────────

    match /notifications/{notifId} {
      allow create: if isAuth();
      allow read: if isAuth() &&
        resource.data.recipientEmail == userEmail();
      allow update: if isAuth() &&
        resource.data.recipientEmail == userEmail();
      allow delete: if isAuth() &&
        resource.data.recipientEmail == userEmail();
    }
  }
}
